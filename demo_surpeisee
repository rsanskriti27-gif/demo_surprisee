<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>A Little Surprise 💗</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  min-height:100vh;
  font-family:Arial, sans-serif;
  background:linear-gradient(135deg,#fff1f7,#f5edff);
  color:#513c49;
  display:flex;
  justify-content:center;
  align-items:center;
  padding:20px;
  overflow-x:hidden;
}

.card{
  width:100%;
  max-width:430px;
  background:rgba(255,255,255,.88);
  border-radius:28px;
  padding:30px 22px;
  text-align:center;
  box-shadow:0 15px 40px rgba(120,70,100,.15);
  position:relative;
  overflow:hidden;
}

.heart{
  position:absolute;
  font-size:24px;
  animation:float 4s infinite ease-in-out;
  opacity:.7;
}

.h1{top:15px;left:18px}
.h2{top:35px;right:20px}
.h3{bottom:25px;left:25px}
.h4{bottom:20px;right:25px}

@keyframes float{
  0%,100%{transform:translateY(0) rotate(-5deg)}
  50%{transform:translateY(-12px) rotate(5deg)}
}

.screen{
  display:none;
  animation:fade .45s ease;
}

.screen.active{
  display:block;
}

@keyframes fade{
  from{
    opacity:0;
    transform:translateY(10px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

.emoji{
  font-size:58px;
  margin-bottom:10px;
}

h1{
  font-size:28px;
  margin:8px 0 12px;
}

h2{
  font-size:23px;
  margin:10px 0 15px;
}

p{
  font-size:16px;
  line-height:1.6;
  margin:10px 0;
}

.small{
  font-size:13px;
  opacity:.65;
}

button{
  border:0;
  background:#e88bb2;
  color:white;
  padding:13px 25px;
  border-radius:30px;
  font-size:15px;
  font-weight:bold;
  margin-top:18px;
  cursor:pointer;
  box-shadow:0 7px 15px rgba(210,100,150,.2);
}

button:active{
  transform:scale(.96);
}

.note{
  background:#fff5fa;
  border-radius:18px;
  padding:16px;
  margin:12px 0;
  text-align:left;
  border:1px solid #f8d9e8;
}

.reason{
  background:#faf5ff;
  border-radius:16px;
  padding:12px;
  margin:9px 0;
  text-align:left;
}

.question{
  font-size:18px;
  font-weight:bold;
  margin-top:15px;
}

.answer{
  display:none;
  margin-top:12px;
  padding:13px;
  background:#fff0f7;
  border-radius:15px;
}

.answer.show{
  display:block;
}

.stickers{
  font-size:30px;
  margin:12px 0;
  letter-spacing:8px;
}

.final{
  font-size:18px;
  font-weight:bold;
  line-height:1.7;
}
</style>
</head>

<body>

<div class="card">

  <div class="heart h1">💗</div>
  <div class="heart h2">🎀</div>
  <div class="heart h3">✨</div>
  <div class="heart h4">💕</div>

  <!-- SCREEN 1 -->
  <div class="screen active">

    <div class="emoji">🎁</div>

    <h1>Surprise for Arav 💗</h1>

    <div class="stickers">🎀 🧸 💌</div>

    <p>
      I made a tiny little corner of the internet<br>
      just for you.
    </p>

    <p class="small">
      And yes... you have to click the button 😌
    </p>

    <button onclick="nextScreen()">
      Open My Surprise 💗
    </button>

  </div>


  <!-- SCREEN 2 -->
  <div class="screen">

    <div class="emoji">💌</div>

    <h2>A Little Note For You</h2>

    <div class="note">
      I don't always know how to say everything
      perfectly, but I hope you know that having
      you in my life means a lot to me. 🤍
    </div>

    <div class="note">
      You're one of those people who can make
      an ordinary day feel a little more special. ✨
    </div>

    <button onclick="nextScreen()">
      There's More 👀
    </button>

  </div>


  <!-- SCREEN 3 -->
  <div class="screen">

    <div class="emoji">🧸</div>

    <h2>Things I Like About You</h2>

    <div class="reason">💗 The way you care.</div>
    <div class="reason">🥹 The little things you remember.</div>
    <div class="reason">😂 How you make me laugh.</div>
    <div class="reason">🤍 The comfort I feel with you.</div>
    <div class="reason">✨ Simply... you being you.</div>

    <button onclick="nextScreen()">
      One More Thing 💌
    </button>

  </div>


  <!-- SCREEN 4 -->
  <div class="screen">

    <div class="emoji">🥹</div>

    <h2>Okay, Quick Question...</h2>

    <p class="question">
      Do you know how special you are to me?
    </p>

    <button onclick="showAnswer()">
      Hmm... Tell Me 👀
    </button>

    <div id="answer" class="answer">
      Very. Very. VERY special. 💗<br><br>
      In case you somehow forgot. 😭🫶
    </div>

    <button onclick="nextScreen()">
      Next 💕
    </button>

  </div>


  <!-- SCREEN 5 -->
  <div class="screen">

    <div class="emoji">🎀</div>

    <h2>Another Question...</h2>

    <p class="question">
      If I had to choose one person to annoy forever...
    </p>

    <p>
      Guess who? 😌
    </p>

    <button onclick="showAnswer2()">
      I have a feeling... 👀
    </button>

    <div id="answer2" class="answer">
      YOU. Obviously. 😂💗
    </div>

    <button onclick="nextScreen()">
      Keep Going ✨
    </button>

  </div>


  <!-- SCREEN 6 -->
  <div class="screen">

    <div class="emoji">💗</div>

    <h2>One Last Thing...</h2>

    <p class="final">
      Thank you for being you.<br><br>

      Thank you for the laughs,
      the conversations,
      the little moments,
      and all the memories we're making. 🤍
    </p>

    <div class="stickers">
      🧸 💕 🌷 ✨
    </div>

    <button onclick="nextScreen()">
      Final Message 💌
    </button>

  </div>


  <!-- SCREEN 7 -->
  <div class="screen">

    <div class="emoji">💝</div>

    <h1>Happy Boyfriend Day! 🥹</h1>

    <p class="final">
      I hope you always remember
      that you're loved, appreciated,
      and very, very special to me. 💗
    </p>

    <p>
      Here's to us and all the little
      moments still waiting to happen. ✨
    </p>

    <div class="stickers">
      💗 🎀 🧸 💌 ✨
    </div>

    <p class="small">
      Made with a little too much love. 🤭
    </p>

  </div>

</div>


<script>

let currentScreen = 0;

const screens = document.querySelectorAll(".screen");

function nextScreen(){

  if(currentScreen < screens.length - 1){

    screens[currentScreen].classList.remove("active");

    currentScreen++;

    screens[currentScreen].classList.add("active");

    window.scrollTo({
      top:0,
      behavior:"smooth"
    });

  }

}

function showAnswer(){

  document.getElementById("answer").classList.add("show");

}

function showAnswer2(){

  document.getElementById("answer2").classList.add("show");

}

</script>

</body>
</html>
